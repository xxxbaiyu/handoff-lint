  "engines": {
    "node": ">=18"
  },
  "main": "handoff-lint.js",
  "bin": {
    "handoff-lint": "handoff-lint.js"
  },
  "files": [
    "handoff-lint.js",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "examples/"
  ],
  "scripts": {
    "test": "node handoff-lint.js selftest",
    "demo": "node handoff-lint.js examples/01-good.md examples/02-injection.md examples/03-missing-redline.md examples/04-code-sample.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1988my/handoff-lint.git"
  },
  "bugs": {
